# --- Coordinator (server) environment ---

# Solana RPC endpoint (Devnet by default)
RPC_URL=https://api.devnet.solana.com

# Deployed program id (run `anchor keys sync` then paste it here + in web)
PROGRAM_ID=Fg6PaFpoGXkYsidMpWTK6W2BeZ7FEfcYkg476zPFsLnS

# Authority keypair that signs open_round / reveal_and_draw / settle / payout.
# Provide ONE of the following. NEVER commit real keys.
#   Inline JSON byte array (recommended for Render secret env):
# AUTHORITY_KEYPAIR=[12,34,...]
#   ...or a path to a keypair file (recommended for local dev):
AUTHORITY_KEYPAIR_PATH=./keys/authority.json

# HTTP/WS port
PORT=4000

# Comma-separated allowed browser origins (your Vercel URL + localhost)
WEB_ORIGIN=http://localhost:3000
