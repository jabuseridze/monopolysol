# =============================================================================
# Coordinator (server) environment
#
# Copy to `.env` for local dev; set the same keys as secrets on Render.
# `.env` is gitignored — never commit real values.
#
# THREE of these are secrets that can lose you money if they leak:
# PAYOUT_KEYPAIR, MASTER_SECRET and DATABASE_URL. Everything else is public.
# =============================================================================

# --- SECRET 1: the database ---------------------------------------------------
#
# REQUIRED. This is where the game's state lives — rounds, guesses, and who has
# been paid. It is not a cache: a round that is not written here is a round a
# redeploy loses, along with the obligation to pay the people who guessed in it.
#
# Supabase: Project Settings → Database → Connection string → URI.
# Anything speaking Postgres works (Render Postgres, Neon, a local server).
# The schema is created automatically on boot — see src/db/schema.sql.
DATABASE_URL=postgresql://user:password@host:5432/postgres


# --- SECRET 2: the payout wallet ----------------------------------------------
#
# Sends every prize and pays the transaction fees. Whoever holds this key can
# empty the wallet, so it should hold only what the game needs in play — not
# your personal funds, and never a wallet you also use elsewhere.
#
# Accepts EITHER form: the JSON byte array the Solana CLI writes, or the base58
# string browser wallets export.
#
#   Inline — use this on Render, pasted as a secret env var:
# PAYOUT_KEYPAIR=[12,34,56,...]     ...or...     PAYOUT_KEYPAIR=4xQy...base58
#
#   ...or a path to a keypair file — easier for local dev:
PAYOUT_KEYPAIR_PATH=./keys/payout.json


# --- SECRET 3: the round seed master secret -----------------------------------
#
# Every round's commit-reveal seed is derived as HMAC(MASTER_SECRET, round_id)
# rather than stored, so a restart can always recompute it (src/secrets.ts).
# Required — the server refuses to boot without it.
#
# Generate with:  openssl rand -hex 32
#
# Anyone holding this can predict every future dice roll before it happens, so
# treat it exactly like the payout key.
#
# It must stay STABLE. Rotating it while a round is open means the revealed seed
# no longer opens the commit that was published — precisely the evidence a
# player would use to call the game rigged. Rotate only between rounds, with the
# coordinator stopped.
MASTER_SECRET=


# --- Chain --------------------------------------------------------------------

# Solana RPC endpoint. Used to send payouts and to read token balances for the
# gate. The public endpoints rate-limit hard, so a provider key (Helius,
# QuickNode — both have free tiers) is worth setting before real traffic.
#
# This one variable decides whether prizes are play money or real money:
#   devnet  → https://api.devnet.solana.com
#   mainnet → https://api.mainnet-beta.solana.com   (REAL SOL)
RPC_URL=https://api.devnet.solana.com

# SPL mint a player must hold to guess — your pump.fun token. Leave blank to run
# with the gate off, which lets anyone who finds the URL play for the real prize.
# Public information; this is not a secret.
GATE_MINT=


# --- Game ---------------------------------------------------------------------

# Prize for the FIRST round on a fresh database only, in lamports
# (1 SOL = 1_000_000_000). After that the stored value wins, because it carries
# the previous round's landing-tile effect — a Random Pump or Get Rugged that
# players already watched resolve. Default: 0.5 SOL.
# BASE_PRIZE_LAMPORTS=500000000


# --- Limits -------------------------------------------------------------------
#
# Bound how many claims one connection can stake on a shared pot.
# See src/guessIntake.ts.

# Picks accepted per round.
MAX_PICKS_PER_ROUND=500
# Guesses one socket may request per round.
MAX_GUESSES_PER_SOCKET=5


# --- Serving ------------------------------------------------------------------

# Render sets this itself; leave it unset there.
PORT=4000

# Comma-separated CORS allowlist. Vercel gives every PREVIEW deployment its own
# URL, so previews are blocked unless listed here alongside production.
WEB_ORIGIN=http://localhost:3000
