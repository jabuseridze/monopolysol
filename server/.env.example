# =============================================================================
# Coordinator (server) environment
#
# Copy to `.env` for local dev; set the same keys as secrets on Render.
# `.env` is gitignored — never commit real values.
#
# TWO of these are secrets that can lose you money if they leak:
# AUTHORITY_KEYPAIR and MASTER_SECRET. Everything else is public information.
# =============================================================================

# --- Chain -------------------------------------------------------------------

# Solana RPC endpoint. The public endpoints rate-limit hard: the coordinator
# polls getProgramAccounts every 4s and every browser polls its own balance, so
# a paid provider is required before real traffic. Server and web are
# configured separately so they can point at different providers.
RPC_URL=https://api.devnet.solana.com

# Deployed program id. Must match web's NEXT_PUBLIC_PROGRAM_ID and Anchor.toml.
PROGRAM_ID=Fg6PaFpoGXkYsidMpWTK6W2BeZ7FEfcYkg476zPFsLnS


# --- SECRET 1: the authority keypair ------------------------------------------
#
# Signs open_round, reveal_and_draw, tally, settle, payout, submit_guess (on
# players' behalf) and close_pick. It also PAYS: transaction fees, and ~0.0013
# SOL of rent for every guess submitted (reclaimed later by the pick sweeper).
#
# Whoever holds this key controls the game and can drain the treasury.
#
# Provide exactly ONE of the two forms below.

#   Inline JSON byte array — use this on Render, pasted as a secret env var:
# AUTHORITY_KEYPAIR=[12,34,56,...]

#   ...or a path to a keypair file — easier for local dev:
AUTHORITY_KEYPAIR_PATH=./keys/authority.json


# --- SECRET 2: the round seed master secret -----------------------------------
#
# Every round's commit-reveal seed is derived as HMAC(MASTER_SECRET, round_id)
# rather than stored, so a restart can always recompute it (see
# server/src/secrets.ts). Required — the server refuses to boot without it.
#
# Generate with:  openssl rand -hex 32
#
# Anyone holding this can predict every future dice roll before it happens, so
# treat it exactly like the authority key.
#
# It must stay STABLE. Rotating it while a round is open leaves that round's
# on-chain commit unopenable, which strands the round permanently. Rotate only
# between rounds, with the coordinator stopped.
MASTER_SECRET=


# --- Token gate ---------------------------------------------------------------

# SPL mint a player must hold to guess. Leave blank to run with the gate off
# (anyone may play), which is the default the program initialises with.
# Public information — this is not a secret.
GATE_MINT=


# --- Spend caps ---------------------------------------------------------------
#
# The house funds every pick, so these bound what a burst of guesses can cost
# before the sweeper reclaims the rent. See server/src/guessIntake.ts.

# Picks the coordinator will fund per round.
MAX_PICKS_PER_ROUND=500
# Refuse to fund new picks below this authority balance, in SOL.
AUTHORITY_MIN_BALANCE_SOL=1
# Guesses one socket may request per round.
MAX_GUESSES_PER_SOCKET=5


# --- Serving ------------------------------------------------------------------

PORT=4000

# Comma-separated CORS allowlist. Vercel gives every PREVIEW deployment its own
# URL, so previews are blocked unless listed here alongside production.
WEB_ORIGIN=http://localhost:3000


# =============================================================================
# NOT an environment variable: the treasury
#
# The treasury holds the prize money, but it has NO private key and no env var,
# and that is deliberate. It is a Program Derived Address — derived from the
# program id and the seed "treasury" — so no keypair for it exists anywhere and
# nobody, including you, can sign for it. Only the program's own `payout`
# instruction can move lamports out, and only to the winner recorded in the
# pick. That is what makes the vault safe to point players at.
#
# To fund it, send SOL to the derived address (any wallet can; `fund_treasury`
# is permissionless). To find that address:
#
#   node -e "const {PublicKey}=require('@solana/web3.js'); \
#     console.log(PublicKey.findProgramAddressSync( \
#       [Buffer.from('treasury')], new PublicKey(process.argv[1]))[0].toBase58())" \
#     <YOUR_PROGRAM_ID>
#
# The same applies to the config and per-round/per-pick accounts: all PDAs,
# all keyless.
# =============================================================================
