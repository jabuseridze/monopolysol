# =============================================================================
# Web (Next.js) environment
#
# Copy to `.env.local` for local dev; set the same keys in the Vercel project.
#
# EVERY value here is `NEXT_PUBLIC_*`, which means it is compiled into the
# JavaScript bundle and visible to anyone who opens devtools. Never put a
# secret in this file — there is nothing here that needs one, because the
# browser no longer signs anything: players paste an address and the
# coordinator submits on their behalf.
# =============================================================================

# Solana RPC endpoint, read-only (balances and token-gate checks).
# Also decides which cluster the Solscan links point at — it is inferred from
# this URL rather than configured separately, so a link can never disagree with
# the chain the app is talking to. Localhost resolves to "localnet", where
# Solscan cannot index anything and the verify button renders disabled.
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com

# Deployed program id. Must match the server's PROGRAM_ID and Anchor.toml.
NEXT_PUBLIC_PROGRAM_ID=Fg6PaFpoGXkYsidMpWTK6W2BeZ7FEfcYkg476zPFsLnS

# Coordinator URL — the Render service in production, localhost in dev.
# Everything the player does goes through this: guesses, presence, the
# countdown, and payout retries.
NEXT_PUBLIC_WS_URL=http://localhost:4000

# SPL mint players must hold. Leave blank to run with the gate off, matching
# the server's GATE_MINT. Only used to show eligibility before a guess is
# submitted -- the real check is on-chain and cannot be bypassed from here.
NEXT_PUBLIC_GATE_MINT=
