# =============================================================================
# Web (Next.js) environment
#
# Copy to `.env.local` for local dev; set the same keys in the Vercel project.
#
# EVERY value here is `NEXT_PUBLIC_*`, which means it is compiled into the
# JavaScript bundle and visible to anyone who opens devtools. Never put a
# secret in this file — there is nothing here that needs one, because the
# browser never signs anything: players paste an address and the coordinator
# records the pick and sends the prize.
#
# These are read at BUILD time, not runtime. Changing one in the Vercel
# dashboard does nothing until you redeploy.
# =============================================================================

# Solana RPC endpoint, read-only — used only to check token-gate balances.
# Also decides which cluster the Solscan links point at: it is inferred from
# this URL rather than configured separately, so a link can never disagree
# with the chain the app is talking to.
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com

# Coordinator URL — the Render service in production, localhost in dev.
# Everything the player does goes through this: guesses, presence, the
# countdown, results and payout retries.
NEXT_PUBLIC_WS_URL=http://localhost:4000

# SPL mint players must hold. Leave blank to run with the gate off, matching
# the server's GATE_MINT. Only used to show eligibility before a guess is
# submitted — the server re-checks it against the pasted address, so a wrong
# value here cannot let a non-holder in.
NEXT_PUBLIC_GATE_MINT=

# =============================================================================
# NOT a variable any more: NEXT_PUBLIC_PROGRAM_ID
#
# The game no longer has an on-chain program. Round state lives in Postgres and
# prizes are ordinary SOL transfers from the coordinator's wallet, so there is
# no program id to configure and nothing derives an address from one.
#
# The wallet prizes are paid from is NOT configured here either — it arrives in
# the live round state from the server. Only the server knows which wallet is
# paying, and a build-time copy here would keep pointing at the old one until
# somebody redeployed the frontend.
# =============================================================================
